+/// Patched (not upstream): the web build can't load fonts at runtime, so Open Sans is embedded
+/// (SIL OFL 1.1, crates/ui-egui/fonts-open-sans/OFL.txt) and bound as the `fnt:Open Sans:*` cell
+/// families, each chaining its own face, then Regular, then the proportional chain.
+const OPEN_SANS: &str = "Open Sans";
+
+#[cfg(target_arch = "wasm32")]
+fn bind_open_sans(fonts: &mut FontDefinitions) -> Vec<String> {
+    const FACES: [(bool, bool, &str, &[u8]); 4] = [
+        (false, false, "open-sans-regular", include_bytes!("../../fonts-open-sans/OpenSans-Regular.ttf")),
+        (true, false, "open-sans-bold", include_bytes!("../../fonts-open-sans/OpenSans-Bold.ttf")),
+        (false, true, "open-sans-italic", include_bytes!("../../fonts-open-sans/OpenSans-Italic.ttf")),
+        (true, true, "open-sans-bold-italic", include_bytes!("../../fonts-open-sans/OpenSans-BoldItalic.ttf")),
+    ];
+    let base: Vec<String> = fonts.families.get(&FontFamily::Proportional).cloned().unwrap_or_default();
+    for (_, _, key, bytes) in FACES {
+        fonts.font_data.insert(key.to_string(), Arc::new(FontData::from_static(bytes)));
+    }
+    let mut bound = Vec::new();
+    for (bold, italic, key, _) in FACES {
+        let mut chain = vec![key.to_string()];
+        if key != FACES[0].2 {
+            chain.push(FACES[0].2.to_string());
+        }
+        chain.extend(base.iter().cloned());
+        let role = crate::fonts::role_key(OPEN_SANS, bold, italic);
+        fonts.families.insert(FontFamily::Name(role.clone().into()), chain);
+        bound.push(role);
+    }
+    bound
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn bind_open_sans(_fonts: &mut FontDefinitions) -> Vec<String> {
+    Vec::new()
+}
+
