 /// References in formula text with their byte spans and colour index (same reference text ⇒
 /// same colour), for colouring the editor and outlining ranges on the grid.
 pub fn formula_refs(text: &str) -> Vec<(usize, usize, RangeRef, Option<String>, usize)> {
+    refs_with(text, &|_, _| None)
+}
+
+/// [`formula_refs`] plus defined names that refer to a plain cell or range, which are coloured
+/// and outlined like references (as Excel does), on the sheet they refer to. A name resolves
+/// against the sheet the edit started on (`origin`), then the workbook.
+pub fn formula_refs_named(text: &str, wb: &gridcraft_engine::model::Workbook, origin: usize) -> Vec<(usize, usize, RangeRef, Option<String>, usize)> {
+    refs_with(text, &|qualifier, name| name_ref(wb, origin, qualifier, name))
+}
+
+/// What a defined name refers to when that is one cell or range (`'Base'!$C$6`,
+/// `Base!$C$14:$DR$14`): a name qualified with a sheet (`Base!rate`) is that sheet's own; an
+/// unqualified one is the `origin` sheet's, else the workbook's. Constants and formulas give `None`.
+fn name_ref(wb: &gridcraft_engine::model::Workbook, origin: usize, qualifier: Option<&str>, name: &str) -> Option<(RangeRef, Option<String>)> {
+    let find = |scope: Option<usize>| wb.names.iter().find(|n| n.scope == scope && n.name.eq_ignore_ascii_case(name));
+    let def = match qualifier {
+        Some(sheet) => find(Some(wb.sheet_index(sheet)?)),
+        None => find(Some(origin)).or_else(|| find(None)),
+    }?;
+    let formula = def.formula.trim();
+    let formula = formula.strip_prefix('=').unwrap_or(formula);
+    match formula_refs(formula).as_slice() {
+        [(0, end, range, sheet, _)] if *end == formula.len() => Some((*range, sheet.clone())),
+        _ => None,
+    }
+}
