+    #[test]
+    fn defined_names_that_are_ranges_are_refs() {
+        use gridcraft_engine::model::{DefinedName, Sheet, Workbook};
+        let mut wb = Workbook::new();
+        wb.sheets.push(std::sync::Arc::new(Sheet::new("Base")));
+        let name = |name: &str, scope: Option<usize>, formula: &str| DefinedName { name: name.into(), scope, formula: formula.into(), comment: String::new(), hidden: false };
+        wb.names = vec![
+            name("rate", Some(1), "'Base'!$C$6"),
+            name("rate", None, "Sheet1!$A$1"),
+            name("series", None, "Base!$C$14:$DR$14"),
+            name("months", None, "12"),
+            name("double", None, "Base!$C$6*2"),
+        ];
+        let text = "=1-(1-IF(E11<=E12,rate,series))^(1/months)+double+SUM(Sheet1!rate)";
+        // Started on Base: the sheet's own `rate` wins over the workbook's.
+        let refs = formula_refs_named(text, &wb, 1);
+        let shown: Vec<_> = refs.iter().map(|r| (&text[r.0..r.1], r.2.a1(), r.3.as_deref())).collect();
+        assert_eq!(
+            shown,
+            [("E11", "E11".into(), None), ("E12", "E12".into(), None), ("rate", "C6".into(), Some("Base")), ("series", "C14:DR14".into(), Some("Base"))],
+            "constants, formulas and a sheet-qualified name with no such sheet-scoped name stay plain"
+        );
+        assert_ne!(refs[2].4, refs[3].4, "each name has its own colour");
+        // Started on Sheet1: only the workbook's `rate` is in scope.
+        let refs = formula_refs_named(text, &wb, 0);
+        assert_eq!((refs[2].2.a1(), refs[2].3.as_deref()), ("A1".into(), Some("Sheet1")));
+        // Qualified with its sheet, a sheet-scoped name resolves from anywhere.
+        let refs = formula_refs_named("=Base!rate+1", &wb, 0);
+        assert_eq!((refs.len(), refs[0].0, refs[0].1, refs[0].2.a1()), (1, 1, 10, "C6".into()));
+        // Without the workbook, names stay plain.
+        assert_eq!(formula_refs(text).len(), 2);
+    }
